# ==============================================================================
# BOUNTY COMMUNITY ENGINE — Root Apache Configuration & Clean URL Router
# File: .htaccess (Root)
# Hostinger PHP 8.2 / Apache 2.4+
# ==============================================================================

Options -Indexes
Options +FollowSymLinks

# ── 1. Security: Deny Web Access to Sensitive Files and Directories ───────────
<FilesMatch "(^\.env.*|^\.git.*|^\.agent.*|NOTE\.md|schema\.sql|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op]))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to hidden and private directories & files
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block browser access to private files & directories
    RewriteRule ^\.agent(/.*)?$ - [F,L]
    RewriteRule ^\.git(/.*)?$ - [F,L]
    RewriteRule ^\.env(.*)?$ - [F,L]
    RewriteRule ^NOTE\.md$ - [F,L]
    RewriteRule ^schema\.sql$ - [F,L]

    # ── 2. Static Asset Routing Without 404s ──────────────────────────────────
    # Pass /css/*, /js/*, and /api/* directly to /public/*
    RewriteRule ^css/(.*)$ public/css/$1 [L,QSA]
    RewriteRule ^js/(.*)$ public/js/$1 [L,QSA]
    RewriteRule ^api/(.*)$ public/api/$1 [L,QSA]

    # If the requested resource exists as a file or directory, serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ── 3. Canonical Clean Portal Routes ──────────────────────────────────────
    # Root URL (/) -> public/portal/index.php
    RewriteRule ^$ public/portal/index.php [L,QSA]

    # User Auth (/login and /signup -> public/portal/auth.php)
    RewriteRule ^login/?$ public/portal/auth.php [L,QSA]
    RewriteRule ^signup/?$ public/portal/auth.php [L,QSA]

    # Admin (/admin/login -> public/admin/login.php, /admin -> public/admin/index.php)
    RewriteRule ^admin/login(\.php)?/?$ public/admin/login.php [L,QSA]
    RewriteRule ^admin(\.php)?/?$ public/admin/index.php [L,QSA]

    # Support (/support/login -> public/support/login.php, /support -> public/support/index.php)
    RewriteRule ^support/login(\.php)?/?$ public/support/login.php [L,QSA]
    RewriteRule ^support(\.php)?/?$ public/support/index.php [L,QSA]

    # Staff & Stuff (/staff/login & /stuff/login -> public/mod/login.php, /staff & /stuff -> public/mod/index.php)
    RewriteRule ^(staff|stuff)/login(\.php)?/?$ public/mod/login.php [L,QSA]
    RewriteRule ^(staff|stuff)(\.php)?/?$ public/mod/index.php [L,QSA]

    # Clean Portal Sub-routes
    RewriteRule ^portal/?$ public/portal/index.php [L,QSA]
    RewriteRule ^portal/job_hub/?$ public/portal/job_hub.php [L,QSA]
    RewriteRule ^portal/candidate_review/?$ public/portal/candidate_review.php [L,QSA]
</IfModule>

# ── 4. HTTP Hardening & Compression ───────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>

# Directory default index
DirectoryIndex index.php public/portal/index.php
