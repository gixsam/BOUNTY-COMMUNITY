# ==============================================================================
# BOUNTY COMMUNITY ENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Project Credentials (Found in Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-jwt-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Platform Configuration
COMMUNITY_NAME="Bounty Community"
PLATFORM_FEE_PERCENT=5.0
ENVIRONMENT=production # production or development
DEFAULT_CURRENCY=USD
COIN_SYMBOL="$"

# Hostinger Domain / Base URL (Leave empty or "/" for root domain, or "/public" for subfolder)
BASE_URL=/
